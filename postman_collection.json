{
  "info": {
    "name": "Fuel Route Optimizer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Coast to coast",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cheapest fuel only (stop_cost = 0)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\",\n  \"stop_cost\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Short trip, single stop (Chicago -> St. Louis)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"St. Louis, MO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Coordinates input (Seattle -> Miami)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"47.6062,-122.3321\",\n  \"finish\": \"25.7617,-80.1918\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Query params (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/?start=Dallas, TX&finish=Denver, CO",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            }
          ]
        }
      }
    },
    {
      "name": "Invalid input (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Atlantis, ZZ\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cities of a state",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/cities/?state=TX",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cities",
            ""
          ],
          "query": [
            {
              "key": "state",
              "value": "TX"
            }
          ]
        }
      }
    },
    {
      "name": "Map page (open in browser)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    }
  ]
}